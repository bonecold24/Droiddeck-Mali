#!/bin/bash
set -u
[ $# -gt 0 ] || { echo "usage: droiddeck-gpu <program> [args...]" >&2; exit 64; }
if [ -n "${BL_DEBUG_DIR:-}" ]; then
  exec >>"$BL_DEBUG_DIR/desktop.log" 2>&1
fi
width=${BL_WIDTH:-1280}
height=${BL_HEIGHT:-720}
args=(--backend wayland --expose-wayland -f -W "$width" -H "$height" -w "$width" -h "$height")
if [ "${BL_FPS:-0}" -gt 0 ]; then
  args+=(-r "$BL_FPS")
elif [ "${BL_REFRESH:-0}" -gt 0 ]; then
  args+=(-r "$BL_REFRESH")
fi
[ "${BL_HDR:-0}" = 1 ] && args+=(--hdr-enabled)
echo "== droiddeck-gpu $(date -u +%H:%M:%S): $* (gamescope ${width}x${height} on wayland-0)"
export WAYLAND_DISPLAY=wayland-0
export GDK_BACKEND=x11 QT_QPA_PLATFORM=xcb SDL_VIDEODRIVER=x11
unset LIBGL_ALWAYS_SOFTWARE QT_QUICK_BACKEND KWIN_COMPOSE
# Mali G720: use PanVK via VK_DRIVER_FILES (set by SessionService), not zink.
# Only force zink when NOT on Mali. On Mali, keep Vulkan on PanVK; zink is
# only a fallback for OpenGL clients that need it.
if [ -e /dev/mali0 ] && [ -n "${VK_DRIVER_FILES:-}" ]; then
    echo "== droiddeck-gpu: Mali detected, using PanVK ($VK_DRIVER_FILES), skipping zink override"
    unset MESA_LOADER_DRIVER_OVERRIDE GALLIUM_DRIVER
    # drm-shim for gamescope's DRM property query on /dev/mali0 (misc, major=10)
    if [ -f /opt/comptest/drm-shim.so ]; then
        export LD_PRELOAD="/opt/comptest/drm-shim.so${LD_PRELOAD:+:$LD_PRELOAD}"
        echo "== droiddeck-gpu: LD_PRELOAD drm-shim for gamescope"
    fi
else
    export MESA_LOADER_DRIVER_OVERRIDE=zink GALLIUM_DRIVER=zink LIBGL_KOPPER_DRI2=true
fi
[ -n "${DROIDDECK_GLTHREAD:-}" ] && export mesa_glthread=$DROIDDECK_GLTHREAD
export APPIMAGE_EXTRACT_AND_RUN=1
gamescope "${args[@]}" -- /usr/local/bin/droiddeck-gpu-window "$@"
rc=$?
echo "== droiddeck-gpu $(date -u +%H:%M:%S): exited $rc"
exit $rc
