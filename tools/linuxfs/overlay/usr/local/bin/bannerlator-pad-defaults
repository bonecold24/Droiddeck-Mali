# ARMSX2 - the PS2 emulator (PCSX2 with ARM64 recompilers; upstream PCSX2 interprets on ARM64). Its
# files are PCSX2's under $XDG_CONFIG_HOME/ARMSX2 (pcsx2/Pcsx2Config.cpp). The user supplies the BIOS
# and the games; they live in the ROMs folder (/root/ROMs). The guide button opens the pause menu
# (Hotkeys OpenPauseMenu) - the way out of a game started from the front end, which runs ARMSX2
# without its window (-batch -bigpicture) - so it is not also the analog toggle here.
ARMSX2_PAD1 = "\n".join(l for l in PCSX2_PAD1.splitlines() if not l.startswith("Analog ")) + "\n"
ROMS = "/root/ROMs"


def ps2_folder():
    for name in ("ps2", "PS2"):
        d = os.path.join(ROMS, name)
        if os.path.isdir(d):
            return d
    return os.path.join(ROMS, "ps2")


def ps2_bios_folder():
    base = ps2_folder()
    for name in ("bios", "BIOS", "firmware"):
        d = os.path.join(base, name)
        if os.path.isdir(d):
            return d
    d = os.path.join(base, "bios")
    if os.path.isdir(ROMS):
        try:
            os.makedirs(d, exist_ok=True)  # where the user is told to put their BIOS
        except OSError:
            pass
    return d


def armsx2():
    root = os.path.join(CONFIG, "ARMSX2")
    ini = os.path.join(root, "inis/PCSX2.ini")
    old = os.path.join(CONFIG, "PCSX2")
    if not os.path.isfile(ini) and os.path.isfile(os.path.join(old, "inis/PCSX2.ini")):
        # Someone who played on PCSX2 here: the same settings, BIOS choice and memory cards (the
        # saves), copied once. PCSX2's own folder is left as it was.
        import shutil
        for sub in ("inis", "memcards", "bios", "gamesettings", "cheats", "patches", "covers",
                    "inputprofiles", "textures"):
            src = os.path.join(old, sub)
            if os.path.isdir(src):
                shutil.copytree(src, os.path.join(root, sub), dirs_exist_ok=True)
        print(f"bannerlator-pad-defaults: ARMSX2: settings and memory cards copied from PCSX2 ({root})")
    elif not os.path.isfile(ini):
        # A new player: ARMSX2's own first-time setup still runs (SetupWizardIncomplete) to pick the
        # BIOS, but looking in the ROMs folder, with the ps2 folder as its game list and the
        # controller already on Player 1.
        bios, games = ps2_bios_folder(), ps2_folder()
        seed(ini, "[UI]\nSettingsVersion = 1\nSetupWizardIncomplete = true\n\n"
                  f"[Folders]\nBios = {bios}\n\n"
                  f"[GameList]\nRecursivePaths = {games}\n\n"
                  # Vulkan outright rather than Auto's pick: the renderer every other path here uses.
                  "[EmuCore/GS]\nRenderer = 14\n\n"
                  "[Hotkeys]\nOpenPauseMenu = Keyboard/Escape\nOpenPauseMenu = SDL-0/Guide\n\n"
                  "[Pad1]\n" + ARMSX2_PAD1, "ARMSX2", "first-time setup, BIOS from " + bios)
        return
    patch_ini_section(ini, "Pad1", ARMSX2_PAD1, "ARMSX2", require="SettingsVersion")
    # The guide button is the pause menu here; PCSX2's profile (ours, copied over) had it as the
    # analog toggle as well.
    with open(ini, encoding="utf-8", errors="replace") as f:
        lines = f.read().splitlines()
    kept = [l for l in lines if l.replace(" ", "") != "Analog=SDL-0/Guide"]
    if len(kept) != len(lines):
        with open(ini + ".tmp", "w", encoding="utf-8") as f:
            f.write("\n".join(kept) + "\n")
        os.replace(ini + ".tmp", ini)
    patch_ini_section(ini, "Hotkeys", "OpenPauseMenu = SDL-0/Guide\n", "ARMSX2", needle="SDL-0/Guide",
                      require="SettingsVersion", done="the guide button opens the pause menu")
    patch_ini_section(ini, "GameList", f"RecursivePaths = {ps2_folder()}\n", "ARMSX2", needle=ROMS,
                      require="SettingsVersion", done="games listed from the ROMs folder")


def dolphin():
    d = os.path.join(CONFIG, "dolphin-emu")
    seed(os.path.join(d, "GCPadNew.ini"), DOLPHIN_GC, "Dolphin (GameCube)")
    seed(os.path.join(d, "WiimoteNew.ini"), DOLPHIN_WII, "Dolphin (Wii)")


# Cemu: an SDLController profile for the GamePad. The uuid is "<index>_<SDL GUID>" and SDL's GUID
# carries a CRC of the device name; this is the one SDL reports for the session's pad
# ("Xbox 360 Controller (0)", 045e:028e - read from RPCS3's SDL log on the device). Mapping ids
# from VPADController.h, values from Controller.h, Cemu's own SDL default layout plus Home.
CEMU_MAP = [(1, 1), (2, 0), (3, 3), (4, 2), (5, 9), (6, 10), (7, 42), (8, 43), (9, 6), (10, 4),
            (11, 11), (12, 12), (13, 13), (14, 14), (15, 7), (16, 8), (17, 45), (18, 39), (19, 44),
            (20, 38), (21, 47), (22, 41), (23, 46), (24, 40), (27, 5)]
CEMU_XML = """<?xml version="1.0" encoding="UTF-8"?>
<emulated_controller>
\t<type>Wii U GamePad</type>
\t<toggle_display>0</toggle_display>
\t<controller>
\t\t<api>SDLController</api>
\t\t<uuid>0_03005e615e0400008e02000010010000</uuid>
\t\t<display_name>Xbox 360 Controller</display_name>
\t\t<rumble>0.5</rumble>
\t\t<mappings>
""" + "".join(f"\t\t\t<entry>\n\t\t\t\t<mapping>{m}</mapping>\n\t\t\t\t<button>{b}</button>\n\t\t\t</entry>\n" for m, b in CEMU_MAP) + """\t\t</mappings>
\t</controller>
</emulated_controller>
"""


def cemu():
    seed(os.path.join(CONFIG, "Cemu/controllerProfiles/controller0.xml"), CEMU_XML, "Cemu")


# melonDS 1.x: raw SDL joystick indices. The session's pad has the kernel's Xbox 360 layout
# (buttons A B X Y LB RB Back Start Guide LS RS = 0..10, hat 0 for the d-pad); the d-pad values
# also take the left stick (EmuInstanceInput.cpp; encoding InputConfig/MapButton.h).
MELONDS_JOY = """[Instance0.Joystick]
A = 1
B = 0
X = 3
Y = 2
L = 4
R = 5
Select = 6
Start = 7
Up = 17891585
Down = 16843012
Left = 1114376
Right = 65794
"""


def melonds():
    path = os.path.join(CONFIG, "melonDS/melonDS.toml")
    if not os.path.isfile(path):
        seed(path, "[Instance0]\nJoystickID = 0\n\n" + MELONDS_JOY, "melonDS")
        return
    with open(path, encoding="utf-8", errors="replace") as f:
        text = f.read()
    try:
        import tomllib
        joy = tomllib.loads(text).get("Instance0", {}).get("Joystick", {})
    except Exception:
        return
    if any(isinstance(v, int) and v != -1 for v in joy.values()):
        return  # something is bound already
    # Replace melonDS's own all-unbound table with ours (a TOML table can be defined only once).
    out, skipping = [], False
    for line in text.splitlines():
        t = line.strip()
        if t.startswith("["):
            skipping = t == "[Instance0.Joystick]"
        if not skipping:
            out.append(line)
    with open(path + ".tmp", "w", encoding="utf-8") as f:
        f.write("\n".join(out).rstrip("\n") + "\n\n" + MELONDS_JOY)
    os.replace(path + ".tmp", path)
    print(f"bannerlator-pad-defaults: melonDS: Player 1 on the controller ({path})")


# PPSSPP (SDL): its pad defaults leave the shoulders, the right stick and the triggers unbound on
# SDL builds (SDLJoystick.cpp codes vs KeyMapDefaults.cpp); a [ControlMapping] that exists replaces
# every default, so this one is complete, keyboard included (device 1 keyboard, 10 pad).
PPSSPP_CONTROLS = """[ControlMapping]
Up = 1-19,10-19
Down = 1-20,10-20
Left = 1-21,10-21
